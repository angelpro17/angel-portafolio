---
import { c4 as models, type C4View } from '@/data/c4';
import { layoutC4, W } from '@/lib/c4';
import { useTranslations, type Language } from '@/i18n/utils';
import type { CaseSlug } from '@/data/projects';

interface Props {
  slug: CaseSlug;
  view: C4View;
  lang: Language;
  /** Names only, no technology, descriptions or labels: used inside the lens of a project card. */
  compact?: boolean;
  /** Draw the diagram step by step when it scrolls into view (case pages). */
  draw?: boolean;
  label?: string;
}
const { slug, view, lang, compact = false, draw = false, label } = Astro.props;
const model = models[slug];
const texts = useTranslations(lang, 'c4')[slug];
const layout = layoutC4(view, model.nodes, texts, { compact });
const uid = `${slug}-${view.level}${compact ? 'c' : ''}`;
---

<svg
  class:list={['c4', { 'c4--compact': compact, 'c4--draw': draw }]}
  viewBox={`0 0 ${W} ${layout.height}`}
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  data-draw={draw ? '' : undefined}
  style={`--np:${layout.primaryCount}`}
>
  <defs>
    <marker id={`end-${uid}`} viewBox="0 0 10 10" refX="9" refY="5" markerWidth="9" markerHeight="9" orient="auto-start-reverse">
      <path d="M1 1.5 9 5 1 8.5z" class="c4__head"></path>
    </marker>
  </defs>

  {layout.edges.map((e, i) => (
    <g class="c4__edge" style={`--k:${i};--p:${e.primaryIndex ?? 0}`}>
      <path
        class="c4__line"
        d={e.d}
        pathLength="100"
        marker-end={`url(#end-${uid})`}
        marker-start={e.both ? `url(#end-${uid})` : undefined}
      ></path>
      {e.step !== null && <path class="c4__pulse" d={e.d} pathLength="100"></path>}
      {!compact && e.label.lines.length > 0 && (
        <text class="c4__tech" text-anchor={e.label.anchor}>
          {e.label.lines.map((line) => <tspan x={e.label.x} y={line.y}>{line.text}</tspan>)}
        </text>
      )}
      {!compact && e.badge && (
        <g class="c4__step" transform={`translate(${e.badge.x} ${e.badge.y})`}>
          <circle r="9.5"></circle>
          <text y="3.6" text-anchor="middle">{e.step}</text>
        </g>
      )}
    </g>
  ))}

  {layout.nodes.map((n) => {
    const left = n.x - n.w / 2;
    const top = n.y - n.h / 2;
    const textX = n.x;
    const nameSize = compact ? 24 : 14;
    const nameLead = compact ? 28 : 17;
    const total = n.nameLines.length * nameLead + n.techLines.length * 14 + n.descLines.length * 14.5;
    let y = n.y - total / 2 + (compact ? 24 : 13) + (n.kind === 'database' ? 5 : 0);
    return (
      <g class={`c4__node c4__node--${n.kind}${n.focus ? ' is-focus' : ''}`} style={`--i:${n.order}`}>
        {n.kind === 'database' ? (
          <>
            <path d={`M${left} ${top + 9} a${n.w / 2} 9 0 0 1 ${n.w} 0 v${n.h - 18} a${n.w / 2} 9 0 0 1 ${-n.w} 0 z`}></path>
            <path class="c4__cap" d={`M${left} ${top + 9} a${n.w / 2} 9 0 0 0 ${n.w} 0`}></path>
          </>
        ) : (
          <rect x={left} y={top} width={n.w} height={n.h} rx={n.kind === 'person' ? 12 : 2}></rect>
        )}
        {n.kind === 'person' && !compact && (
          <g class="c4__glyph" transform={`translate(${left + n.w - 22} ${top + 12})`}>
            <circle cx="0" cy="3" r="3.6"></circle>
            <path d="M-6.5 13c.6-4.2 3-6 6.5-6s5.9 1.8 6.5 6"></path>
          </g>
        )}
        {n.kind === 'queue' && !compact && (
          <path class="c4__glyph" d={`M${left + n.w - 30} ${top + 9} l5 4-5 4M${left + n.w - 22} ${top + 9} l5 4-5 4`}></path>
        )}
        <text class="c4__name" x={textX} y={y} text-anchor="middle" style={`font-size:${nameSize}px`}>
          {n.nameLines.map((line, li) => <tspan x={textX} dy={li === 0 ? 0 : nameLead}>{line}</tspan>)}
        </text>
        {n.techLines.length > 0 && (
          <text class="c4__stack" x={textX} y={(y += (n.nameLines.length - 1) * nameLead + 16)} text-anchor="middle">
            {n.techLines.map((line, li) => <tspan x={textX} dy={li === 0 ? 0 : 12}>{line}</tspan>)}
          </text>
        )}
        {n.descLines.length > 0 && (
          <text class="c4__desc" x={textX} y={(y += (n.techLines.length ? (n.techLines.length - 1) * 12 + 17 : 17))} text-anchor="middle">
            {n.descLines.map((line, li) => <tspan x={textX} dy={li === 0 ? 0 : 14.5}>{line}</tspan>)}
          </text>
        )}
      </g>
    );
  })}
</svg>

<style>
  .c4 {
    width: 100%;
    height: auto;
    overflow: visible;
  }
  .c4__line {
    fill: none;
    stroke: var(--color-parchment);
    stroke-opacity: 0.55;
    stroke-width: 1.4;
    stroke-dasharray: 100;
    stroke-dashoffset: 0;
  }
  .c4__head {
    fill: var(--color-parchment);
    fill-opacity: 0.8;
  }
  .c4__pulse {
    fill: none;
    stroke: var(--color-ember-lit);
    stroke-width: 4;
    stroke-linecap: round;
    stroke-dasharray: 2.2 97.8;
    stroke-dashoffset: 2.2;
    animation: c4-travel 2.4s linear calc(var(--p) * 0.8s) infinite;
  }
  @keyframes c4-travel {
    to {
      stroke-dashoffset: -97.8;
    }
  }
  .c4__tech {
    fill: var(--color-parchment);
    fill-opacity: 0.78;
    font: 400 10.5px var(--font-mono);
    paint-order: stroke;
    stroke: var(--color-ink);
    stroke-width: 5px;
    stroke-linejoin: round;
  }
  .c4__step circle {
    fill: var(--color-ember);
  }
  .c4__step text {
    fill: var(--color-parchment);
    font: 400 11px var(--font-mono);
  }

  .c4__node rect,
  .c4__node > path:not(.c4__cap):not(.c4__glyph) {
    fill: #2a2927;
    stroke: var(--color-parchment);
    stroke-width: 1.3;
  }
  .c4__cap {
    fill: none;
    stroke: var(--color-parchment);
    stroke-width: 1.3;
  }
  .c4__glyph {
    fill: none;
    stroke: var(--color-ember-lit);
    stroke-width: 1.4;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .c4__glyph circle {
    fill: var(--color-ember-lit);
    stroke: none;
  }
  .c4__node--person rect {
    stroke: var(--color-ember-lit);
    fill: #33302c;
  }
  .c4__node--component rect {
    fill: #34322f;
    stroke-opacity: 0.8;
  }
  .c4__node--external rect {
    fill: none;
    stroke: #a39d95;
    stroke-dasharray: 5 4;
  }
  .c4__node--queue rect {
    stroke-width: 1.8;
  }
  .c4__name {
    fill: var(--color-parchment);
    font-family: var(--font-display);
  font-variation-settings: 'opsz' 36;
    font-weight: 700;
    letter-spacing: -0.02em;
  }
  .c4__stack {
    fill: var(--color-ember-lit);
    font: 400 9.5px var(--font-mono);
  }
  .c4__desc {
    fill: var(--color-parchment);
    fill-opacity: 0.78;
    font: 400 11px var(--font-text);
  }
  .c4__node--external .c4__name,
  .c4__node--external .c4__desc {
    fill-opacity: 0.88;
  }
  /* The system under focus is inverted: parchment plate, ink type. */
  .c4__node.is-focus rect {
    fill: var(--color-parchment);
    stroke: var(--color-parchment);
  }
  .c4__node.is-focus .c4__name,
  .c4__node.is-focus .c4__desc {
    fill: var(--color-ink);
    fill-opacity: 1;
  }
  .c4--compact .c4__name {
    letter-spacing: -0.025em;
  }

  @media (prefers-reduced-motion: reduce) {
    .c4__pulse {
      display: none;
    }
  }

  /* Draw-in: nodes appear in order, then the lines trace, then labels, then the pulse starts. */
  @media (prefers-reduced-motion: no-preference) and (scripting: enabled) {
    .c4--draw .c4__node {
      opacity: 0;
      translate: 0 8px;
    }
    .c4--draw .c4__line {
      stroke-dashoffset: 100;
    }
    .c4--draw .c4__tech,
    .c4--draw .c4__step,
    .c4--draw .c4__pulse {
      opacity: 0;
    }
    .c4--draw.is-drawn .c4__node {
      opacity: 1;
      translate: 0 0;
      transition:
        opacity 500ms var(--ease-sig) calc(var(--i) * 70ms),
        translate 600ms var(--ease-sig) calc(var(--i) * 70ms);
    }
    .c4--draw.is-drawn .c4__line {
      stroke-dashoffset: 0;
      transition: stroke-dashoffset 800ms var(--ease-sig) calc(300ms + var(--k) * 90ms);
    }
    .c4--draw.is-drawn .c4__tech,
    .c4--draw.is-drawn .c4__step {
      opacity: 1;
      transition: opacity 400ms var(--ease-sig) calc(700ms + var(--k) * 90ms);
    }
    .c4--draw.is-drawn .c4__pulse {
      opacity: 1;
      transition: opacity 300ms var(--ease-sig) 2000ms;
    }
  }
</style>
