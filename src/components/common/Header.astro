---
import { useTranslations, homePath, sectionPath, type Language } from '@/i18n/utils';
import { profile } from '@/data/profile';

interface Props {
  lang: Language;
  alternates: Record<Language, string>;
}
const { lang, alternates } = Astro.props;
const nav = useTranslations(lang, 'nav');
const other: Language = lang === 'es' ? 'en' : 'es';
const links = [
  { id: 'work', label: nav.work },
  { id: 'path', label: nav.path },
  { id: 'contact', label: nav.contact },
] as const;
---

<header class="site-header" data-header>
  <div class="site-header__bar">
    <span class="site-header__city">{nav.city}</span>
    <a class="site-header__brand" href={homePath(lang)} aria-label={nav.home}>
      <img src="/brand/logo.svg" width="530" height="76" alt={profile.name} loading="eager" fetchpriority="high" />
    </a>

    <nav class="site-header__nav" aria-label={nav.navLabel}>
      {links.map((l) => <a class="link" href={sectionPath(lang, l.id)}>{l.label}</a>)}
      <a class="link" href={alternates[other]} hreflang={other} lang={other} aria-label={nav.switchLabel}>{nav.switchTo}</a>
      <button class="link" type="button" data-cv-open>{nav.cv}</button>
    </nav>

    <details class="site-header__menu">
      <summary>{nav.menu}</summary>
      <nav aria-label={nav.navLabel}>
        {links.map((l) => <a href={sectionPath(lang, l.id)}>{l.label}</a>)}
        <a href={alternates[other]} hreflang={other} lang={other} aria-label={nav.switchLabel}>{nav.switchTo}</a>
        <button type="button" data-cv-open>{nav.cv}</button>
      </nav>
    </details>
  </div>
</header>

<style>
  .site-header {
    position: relative;
    z-index: 50;
    background: var(--color-parchment);
    border-bottom: 1px solid var(--color-ink);
  }
  @media (min-width: 900px) {
    .site-header {
      position: sticky;
      top: 0;
    }
  }
  .site-header__bar {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: 12px 24px;
    max-width: 1440px;
    margin-inline: auto;
    min-height: 56px;
    padding: 10px clamp(16px, 3vw, 43px);
    font-size: 19px;
    letter-spacing: -0.015em;
  }
  .site-header__city,
  .site-header__nav {
    display: none;
  }
  .site-header__brand {
    display: block;
    width: clamp(190px, 23vw, 250px);
    font-family: var(--font-display);
  font-variation-settings: 'opsz' 36;
    font-weight: 700;
    letter-spacing: -0.03em;
    font-size: 21px;
  }
  .site-header__brand img {
    width: 100%;
    height: auto;
  }
  @media (min-width: 900px) {
    .site-header__bar {
      grid-template-columns: 1fr auto 1fr;
    }
    .site-header__city {
      display: block;
    }
    .site-header__brand {
      text-align: center;
    }
    .site-header__nav {
      display: flex;
      flex-wrap: wrap;
      justify-content: flex-end;
      gap: 4px 22px;
      font-size: 17px;
    }
    .site-header__menu {
      display: none;
    }
  }

  /* Mobile menu */
  .site-header__menu summary {
    list-style: none;
    cursor: pointer;
    justify-self: end;
    padding: 4px 0;
    border-bottom: 1px solid currentColor;
  }
  .site-header__menu summary::-webkit-details-marker {
    display: none;
  }
  .site-header__menu nav {
    display: none;
  }
  .site-header__menu[open] nav {
    position: absolute;
    left: 0;
    right: 0;
    top: 100%;
    display: grid;
    gap: 0;
    background: var(--color-parchment);
    border-bottom: 1px solid var(--color-ink);
  }
  .site-header__menu nav a,
  .site-header__menu nav button {
    padding: 14px clamp(16px, 3vw, 43px);
    border-top: 1px solid var(--color-bone);
    font-size: 22px;
  }
  .site-header__menu nav button {
    border-inline: 0;
    border-bottom: 0;
    background: none;
    color: inherit;
    font: inherit;
    font-size: 22px;
    text-align: left;
    cursor: pointer;
  }
</style>
