---
import Banner from '@/components/common/Banner.astro';
import SectionIntro from '@/components/common/SectionIntro.astro';
import ProjectLens from '@/components/work/ProjectLens.astro';
import type { CaseSlug } from '@/data/projects';
import type { Language } from '@/i18n/utils';

interface Props {
  lang: Language;
  slugs: readonly CaseSlug[];
  index: string;
  banner: string;
  label: string;
  intro: string;
  id?: string;
  /** Three columns on wide screens (used for the many small cards). */
  three?: boolean;
  hint?: string;
  hintTouch?: string;
}
const { lang, slugs, index, banner, label, intro, id, three = false, hint, hintTouch } = Astro.props;
---

<div {id}>
  <Banner text={banner} {label} />
  <SectionIntro {index} {intro} />
  {hint && (
    <div class="wrap">
      <p class="mono soft hint hint--pointer">{hint}</p>
      <p class="mono soft hint hint--touch">{hintTouch}</p>
    </div>
  )}
  <div class:list={['wrap', 'work-grid', { 'work-grid--three': three }]}>
    {slugs.map((slug, i) => <ProjectLens {slug} {lang} delay={(i % (three ? 3 : 2)) * 120} radius={three ? 120 : 150} />)}
  </div>
</div>

<style>
  .work-grid {
    display: grid;
    column-gap: clamp(28px, 3vw, 43px);
    row-gap: clamp(48px, 5.4vw, 84px);
    padding-block: clamp(28px, 4vw, 58px) clamp(48px, 7vw, 115px);
  }
  @media (min-width: 900px) {
    .work-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 1200px) {
    .work-grid--three {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  .hint {
    margin: 16px 0 0;
  }
  .hint--touch {
    display: none;
  }
  @media (hover: none), (pointer: coarse) {
    .hint--pointer {
      display: none;
    }
    .hint--touch {
      display: block;
    }
  }
</style>
