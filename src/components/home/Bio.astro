---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import portrait from '@/assets/images/portrait.webp';
import { profile } from '@/data/profile';
import { useTranslations, type Language } from '@/i18n/utils';

interface Props {
  lang: Language;
}
const { lang } = Astro.props;
const t = useTranslations(lang, 'opening');
const photoAlt = useTranslations(lang, 'closing').photoAlt;
---

<section class="bio wrap" aria-label={t.bioHeadline}>
  <figure class="bio__portrait" data-reveal="wipe">
    <Image src={portrait} alt={photoAlt} widths={[360, 540, 720]} sizes="(min-width: 1100px) 320px, 80vw" quality={85} loading="lazy" />
  </figure>

  <div class="bio__text" data-reveal style="--d:80ms">
    <p aria-label={`${t.bioDrop}${t.bioRest}`}>
      <span class="bio__drop" aria-hidden="true">{t.bioDrop}</span><span aria-hidden="true">{t.bioRest}</span>
    </p>
    <p class="bio__now">
      <span class="eyebrow">{t.now}</span><br />
      {t.nowText}
    </p>
    <ul class="bio__links">
      <li><button class="link" type="button" data-contact-open><Icon name="mail" /> {t.email}</button></li>
      <li><a class="link" href={profile.github} target="_blank" rel="noopener"><Icon name="logo-github" /> GitHub</a></li>
      <li><a class="link" href={profile.linkedin} target="_blank" rel="noopener"><Icon name="logo-linkedin" /> LinkedIn</a></li>
    </ul>
  </div>

  <h2 class="headline bio__headline" data-reveal style="--d:140ms">{t.bioHeadline}</h2>
</section>

<style>
  .bio {
    display: grid;
    gap: clamp(28px, 4vw, 58px);
    padding-block: clamp(40px, 6vw, 96px);
  }
  @media (min-width: 1100px) {
    .bio {
      grid-template-columns: 300px minmax(0, 0.9fr) minmax(0, 1.2fr);
      align-items: start;
    }
  }
  .bio__portrait {
    margin: 0;
    max-width: 320px;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: var(--color-bone);
    border-radius: 11.5px;
    box-shadow: var(--shadow-card);
  }
  .bio__portrait :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 30%;
  }
  .bio__text p {
    margin: 0;
    max-width: 32em;
  }
  .bio__drop {
    float: left;
    margin: 0.04em 0.12em 0 0;
    font-family: var(--font-banner);
  font-variation-settings: 'opsz' 36;
    font-weight: 900;
    font-size: 5.2em;
    line-height: 0.78;
    letter-spacing: 0;
  }
  .bio__now {
    margin-top: 28px !important;
    padding-top: 16px;
    border-top: 1px solid var(--color-bone);
    clear: both;
  }
  .bio__links {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 26px;
    margin: 20px 0 0;
    padding: 0;
    list-style: none;
    font-size: 17px;
  }
  .bio__headline {
    margin: 0;
    font-size: clamp(40px, 6vw, 92px);
    text-wrap: balance;
  }
</style>
