---
import { Image } from 'astro:assets';
import { marqueeRows } from '@/data/projects';
import { useTranslations, workPath, type Language } from '@/i18n/utils';

interface Props {
  lang: Language;
}
const { lang } = Astro.props;
const projects = useTranslations(lang, 'projects');
const label = useTranslations(lang, 'opening').marquee;
const copies = [0, 1];
---

<section class="marquee" aria-label={label}>
  {marqueeRows.map((row, ri) => (
    <div class={`marquee__row marquee__row--${ri}`}>
      <ul class="marquee__track">
        {copies.map((copy) =>
          row.map((tile) => {
            const name = projects[tile.slug].name;
            return (
              <li class="marquee__item" aria-hidden={copy === 1 ? 'true' : undefined}>
                <a class="tile" href={workPath(tile.slug, lang)} tabindex={copy === 1 ? -1 : undefined}>
                  <Image
                    class="tile__img"
                    src={tile.image}
                    alt={copy === 1 ? '' : name}
                    widths={[420, 640, 880]}
                    sizes="(min-width: 1024px) 440px, 78vw"
                    quality={80}
                    loading={ri === 0 && copy === 0 ? 'eager' : 'lazy'}
                  />
                  <span class="tile__cap mono">{name}</span>
                </a>
              </li>
            );
          }),
        )}
      </ul>
    </div>
  ))}
</section>

<style>
  .marquee {
    display: grid;
    gap: 22px;
    padding-block: clamp(24px, 3vw, 40px);
    overflow: hidden;
    border-bottom: 1px solid var(--color-ink);
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 5%, #000 95%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 5%, #000 95%, transparent);
  }
  .marquee__track {
    display: flex;
    gap: 22px;
    width: max-content;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .marquee__item {
    flex: none;
    width: clamp(260px, 30vw, 460px);
  }
  .tile {
    display: block;
    color: inherit;
  }
  .tile__img {
    width: 100%;
    aspect-ratio: 1.86;
    object-fit: cover;
    object-position: top center;
    background: var(--color-bone);
    border: 1px solid var(--color-ink);
    transition: translate 300ms var(--ease-sig);
  }
  .tile__cap {
    display: block;
    margin-top: 8px;
    color: var(--color-charcoal);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-size: 11px;
    transition: color 150ms var(--ease-sig);
  }
  .tile:hover .tile__img {
    translate: 0 -4px;
  }
  .tile:hover .tile__cap,
  .tile:focus-visible .tile__cap {
    color: var(--color-ember);
  }

  @media (prefers-reduced-motion: no-preference) {
    .marquee__row--0 .marquee__track {
      animation: slide 95s linear infinite;
    }
    .marquee__row--1 .marquee__track {
      animation: slide 110s linear infinite reverse;
    }
    .marquee:hover .marquee__track,
    .marquee:focus-within .marquee__track {
      animation-play-state: paused;
    }
  }
  @keyframes slide {
    to {
      transform: translateX(calc(-50% - 11px));
    }
  }
  /* Reduced motion: no scrolling loop; each row is a normal swipeable strip. */
  @media (prefers-reduced-motion: reduce) {
    .marquee {
      -webkit-mask-image: none;
      mask-image: none;
    }
    .marquee__row {
      overflow-x: auto;
      padding-inline: clamp(16px, 3vw, 43px);
      scroll-snap-type: x proximity;
    }
    .marquee__item {
      scroll-snap-align: start;
    }
    .marquee__item[aria-hidden='true'] {
      display: none;
    }
    .tile__img,
    .tile__cap {
      transition: none;
    }
  }
</style>
