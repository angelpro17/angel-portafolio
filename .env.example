# CV lead gate (all server-side). Without RESEND_API_KEY the flow runs in dev mode:
# the code is returned in the API response and logged, and no email is sent.
RESEND_API_KEY=
# Sender on a domain verified in Resend, e.g. "Angel Anampa <cv@angelanampa.dev>"
CV_FROM=
# Private inbox: receives each verified CV lead and every contact-form message. Never shown on the site.
NOTIFY_TO=you@example.com
# 32+ random chars: openssl rand -base64 48
OTP_SECRET=
# Optional: rate limits + single-use codes (Upstash Redis REST)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
